#!/usr/bin/env bash
# llmi — la cara de host de `llminbox`. Lo que un agente invoca de verdad.
#
# POR QUÉ EXISTE
#   El primitivo que la flota usa hoy es `tail -N` sobre un fichero de 54 MB:
#   27.983 tokens para ver 49 entradas ≈ 10 minutos de historia a hora punta, y
#   sin forma de preguntar "¿qué hay para MÍ desde la última vez?". Medido
#   2026-07-27: en 5.580 de 6.432 relecturas consecutivas habían aparecido
#   entradas fuera de esa ventana.
#
# PROPIEDAD DE DISEÑO (probada, no prometida — falsador T5)
#   Si el servicio no está, esto NO bloquea a nadie: avisa y te dice el comando
#   de siempre. El markdown sigue siendo el canon; esto es un atajo, no una
#   dependencia. Cualquier cosa que haga que un agente se quede esperando a un
#   contenedor es un bug de este fichero, no un inconveniente.
set -uo pipefail

API="${LLMINBOX_API:-http://127.0.0.1:8077}"
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# El token NO es opcional. Publicar en 127.0.0.1 no aísla en Docker Desktop para
# macOS: comprobado en vivo, un contenedor de otra red llega por
# `host.docker.internal` y leía el canon entero sin credencial.
TOKFILE="$HOME/.llminbox.token"
if [ -r "$TOKFILE" ]; then TOKEN="$(tr -d '\n' < "$TOKFILE")"; else TOKEN=""; fi
H=(-H "X-Llminbox-Token: $TOKEN")

# Fichero de censo — lo escribe `llmi init` (o a mano `cp roster.example.json
# roster.json`). Sin él, el mount de `/censo.json` lo sustituye Docker por un
# directorio vacío en silencio; ver docker-compose.yml.
ROSTER="$DIR/roster.json"

# Mapa nombre-lógico → ruta de HOST de cada ledger, para el detector de deriva
# de `stat`. Antes era un array bash fijo con los 6 ledgers de una sola empresa;
# ahora lo escribe `llmi init` junto con `docker-compose.override.yml`, así
# que sirve para los ledgers de QUIEN sea que lo instale, no solo para los
# nuestros. Formato: JSON `{"nombre": "/ruta/host/al/fichero.md", ...}`.
MOUNTS="$DIR/.llmi-mounts.json"

vivo() { curl -sf -m 3 "$API/health" >/dev/null 2>&1; }

# GET /inbox/$1: 200 → cuerpo por stdout, rc=0. 422 → censo rechaza el nombre:
# mensaje del servicio a stderr, rc=4. Cualquier otro fallo (conexión, timeout,
# 5xx) → sin_servicio, rc=3. `-f` no distingue 422 de "no hay nadie escuchando":
# los dos vuelven no-cero y sin cuerpo. `-w`+`-o` conservan el código real y el
# cuerpo aparte, para poder mirar los dos.
_get_inbox_o_422() {  # $1=agente $2=limit
  local cuerpo cod
  cuerpo="$(mktemp)"
  cod="$(curl -s -m 10 "${H[@]}" -o "$cuerpo" -w '%{http_code}' "$API/inbox/$1?limit=$2")" \
    || { rm -f "$cuerpo"; sin_servicio; return 3; }
  case "$cod" in
    200) cat "$cuerpo"; rm -f "$cuerpo"; return 0 ;;
    422) python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("detail",""), file=sys.stderr)
except Exception: print(open(sys.argv[1]).read(), file=sys.stderr)' "$cuerpo"
         rm -f "$cuerpo"; return 4 ;;
    *)   rm -f "$cuerpo"; sin_servicio; return 3 ;;
  esac
}

sin_servicio() {
  echo "· llminbox no responde en $API — el markdown sigue ahí, nadie está bloqueado." >&2
  echo "  arráncalo:  llmi up" >&2
  echo "  o tira de lo de siempre:  tail -200 <tu-ledger.md>" >&2
  return 3          # 3 = servicio ausente. Distinto de 1 (hallazgo) y 2 (uso).
}

uso() {
  cat <<'EOF'
llmi — consulta la red de ledgers de la flota sin quemarte la ventana

  llmi init                 día uno: descubre tus ledgers, arma el compose
  llmi up | down | logs     ciclo de vida del contenedor
  llmi inbox <agente> [n] [--carril <c>]   lo NUEVO dirigido a ti (avanza tu cursor;
                                            con --carril, SOLO consume el cursor del
                                            ledger de ese carril — o usa BIK_CARRIL)
  llmi peek  <agente>       igual, pero SIN consumir
  llmi to    <agente> [n]   lo último dirigido a un agente
  llmi q     <texto> [n]    busca en el cuerpo de las entradas
  llmi stat                 estado por ledger + DETECTOR DE DERIVA de montaje
  llmi lint  [ledger]       deuda de tipado (qué entradas no declaran nada)
  llmi verify               integridad del canon (¿ha desaparecido alguna entrada?)
  llmi canon [n]            cola de destilación: lo dirigido que aún no es página
  llmi adopcion [--json]    quién LEE su bandeja y quién la consume (no es lo mismo)
  llmi wiki [q]             las páginas de tu wiki, con sus citas al ledger
  llmi wiki citas           ¿cada cita apunta a una entrada que existe? (el gate)
  llmi wiki <ruta.md>       una página entera, con sus citas YA resueltas
  llmi canon marca <eid> <kb:ruta>   imprime el apunte que cierra una entrada

Salidas: 0 ok · 1 hallazgo (entrada desaparecida / deriva) · 2 uso · 3 servicio ausente
         · 4 identidad no resuelta (422 — nombre fuera de censo)
EOF
}

# Tamaño de fichero portable. `stat -f%z` es BSD/macOS; `stat -c%s` es GNU/Linux.
# Sin esto, cualquiera fuera de macOS ejecuta `llmi stat` el primer día y el
# detector de deriva se rompe con "illegal option -- f", sin ninguna pista de
# qué pasó (medido: era el primer bug que se llevaba un usuario de Linux).
_bytes() {
  stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null \
    || python3 -c "import os,sys;print(os.path.getsize(sys.argv[1]))" "$1" 2>/dev/null
}

# ── descubrimiento de ledgers (para `llmi init`) ─────────────────────────
# Busca ficheros `*ledger*.md` en un directorio, acotado en PROFUNDIDAD y en
# TIEMPO. Un "no encontré nada" que en realidad es "dejé de buscar" es una
# mentira, así que si el límite de tiempo corta la búsqueda, LO DICE por stderr
# en vez de callarse — mejor un aviso de más que un censo incompleto sin marcar.
_find_acotado() {
  local dir="$1" prof="$2" limite_s="$3" out pid pasos maxpasos
  [ -d "$dir" ] || return 0
  out="$(mktemp)"
  ( find "$dir" -maxdepth "$prof" \
      \( -iname '.git' -o -iname 'node_modules' -o -iname '__pycache__' \
         -o -iname '.cache' -o -iname 'Library' -o -iname '.Trash' \
         -o -iname '.npm' -o -iname '.cargo' -o -iname '.rustup' \
         -o -iname 'venv' -o -iname '.venv' -o -iname 'dist' -o -iname 'build' \
      \) -prune -o -type f -iname '*ledger*.md' -print 2>/dev/null > "$out" ) &
  pid=$!
  pasos=0; maxpasos=$((limite_s * 5))     # sondeo cada 0.2s
  while kill -0 "$pid" 2>/dev/null; do
    sleep 0.2
    pasos=$((pasos + 1))
    if [ "$pasos" -ge "$maxpasos" ]; then
      kill "$pid" 2>/dev/null
      echo "  ⚠ búsqueda en $dir truncada a ${limite_s}s (profundidad $prof) — puede haber más ledgers sin descubrir ahí" >&2
      break
    fi
  done
  wait "$pid" 2>/dev/null
  cat "$out"; rm -f "$out"
}

# ── EXCLUSIONES del descubrimiento ─────────────────────────────────────────
# `init` NO puede decidir solo qué ledgers son tuyos. En la primera ejecución real
# (2026-07-27) descubrió 27 ficheros e iba a montar dos que su dueño tiene PROHIBIDO
# tocar —el de un cliente y el de otro equipo—, además de doce copias de seguridad,
# un fichero de protocolo que no es un ledger, y una nota de sesión.
#
# Un descubridor que acierta el 60% y monta el 40% restante en silencio es peor que
# uno que pregunta: montar el ledger equivocado en modo lectura ya expone su contenido
# a quien alcance el puerto. Así que: se excluye lo obvio, y lo demás se CONFIRMA.
#
# Pon aquí lo que nunca debe indexarse (una expresión por línea, se usa con grep -E).
# Y un fichero local `.llminbox-excluir` (gitignorado) para la política de cada
# máquina: qué ledgers existen y son válidos pero NO son tuyos. Eso no lo deduce
# ningún patrón — el descubridor encontró el de un cliente y el de otro equipo, y
# los dos eran ledgers legítimos.
_EXCL_LOCAL=""
if [ -r "$DIR/.llminbox-excluir" ]; then
  _EXCL_LOCAL="$(grep -vE '^\s*(#|$)' "$DIR/.llminbox-excluir" | paste -sd'|' -)"
fi
LLMINBOX_EXCLUIR="${LLMINBOX_EXCLUIR:-\.llminbox-demo|RESPALDO|respaldo|BACKUP|backup|\.bak|/Dropbox/|/Google Drive/|/OneDrive/|/iCloud|PROTOCOL|preswap|historico|_runtime/|/node_modules/|/\.git/}"
[ -n "$_EXCL_LOCAL" ] && LLMINBOX_EXCLUIR="$LLMINBOX_EXCLUIR|$_EXCL_LOCAL"

_descubrir_ledgers() {
  # $PWD primero (barato, casi siempre donde se invoca): si además está dentro
  # de un repo git cuya raíz es distinta, se barre también la raíz — un ledger
  # puede vivir un par de niveles por encima de donde uno corre `llmi`.
  _find_acotado "$PWD" 4 5
  local gitroot
  gitroot="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$gitroot" ] && [ "$gitroot" != "$PWD" ]; then
    _find_acotado "$gitroot" 4 5
  fi
  # $HOME es el barrido caro: menos profundidad, más presupuesto de tiempo.
  _find_acotado "$HOME" 3 8
}

# Filtro: el descubrimiento propone, la exclusión dispone. Se aplica AQUÍ y no en
# el `find` para que el usuario pueda ver en `--dry-run` qué se descartó y por qué.
_descubrir_filtrado() {
  _descubrir_ledgers | grep -vE "$LLMINBOX_EXCLUIR" || true
}

# ── detector de DERIVA DE MONTAJE ────────────────────────────────────────────
# Un bind-mount de fichero se ata al inodo: si alguien hace `mv` o reescribe el
# ledger, el contenedor sigue viendo el fichero VIEJO y no se entera. El servicio
# no puede detectarlo solo —desde dentro, su fichero está perfectamente bien—.
# Solo se ve comparando desde el host, contra el mapa que escribió `llmi init`.
deriva() {
  local malas=0 n p hb sb json
  if [ ! -r "$MOUNTS" ]; then
    echo "  · sin datos de montaje ($MOUNTS no existe) — corre: llmi init"
    return 0
  fi
  json="$(curl -sf -m 5 "${H[@]}" "$API/stat")" || { sin_servicio; return 3; }
  while IFS=$'\t' read -r n p; do
    [ -n "$n" ] || continue
    [ -f "$p" ] || { printf "  ⚠ %-14s no existe en el host: %s\n" "$n" "$p"; malas=$((malas+1)); continue; }
    hb="$(_bytes "$p")"
    sb="$(printf '%s' "$json" | python3 -c \
      "import sys,json;d=json.load(sys.stdin);print(next((x['bytes'] for x in d if x['ledger']=='$n'),''))" 2>/dev/null)"
    if [ -z "$sb" ]; then
      printf "  ⚠ %-14s el servicio no lo conoce\n" "$n"; malas=$((malas+1))
    elif [ "$hb" != "$sb" ]; then
      printf "  🔴 %-14s DERIVA: host=%s contenedor=%s (Δ%s) — el montaje mira a otro inodo;\n" \
        "$n" "$hb" "$sb" "$((hb-sb))"
      printf "      arréglalo con: llmi down && llmi up\n"
      malas=$((malas+1))
    fi
  done < <(python3 -c "import json,sys;d=json.load(open(sys.argv[1],encoding='utf-8'));[print(f'{k}\t{v}') for k,v in d.items()]" "$MOUNTS" 2>/dev/null)
  return $((malas > 0 ? 1 : 0))
}

# ── init: lo que convierte esto en instalable por un desconocido ────────────
# En una sola invocación: token, descubrir ledgers reales del disco (acotado y
# sincero sobre lo que se dejó sin mirar), escribir el compose de override con
# el montaje correcto por ledger (fichero si solo se escribe con `>>`, directorio
# si vive en un repo git — porque `git pull` reemplaza el fichero, no lo apendiza,
# y un bind-mount de fichero se queda atado al inodo viejo), y un roster.json de
# arranque. Si no hay NINGÚN ledger, no falla: crea uno de ejemplo para que el
# día uno no sea una pantalla vacía. Todo lo que se pueda deducir, se deduce; lo
# que no (a quién pertenece cada agente descubierto), se dice explícitamente en
# vez de inventarlo.
hacer_init() {
  echo "== llmi init =="

  if [ -r "$TOKFILE" ]; then
    echo "· token: ya existe ($TOKFILE)"
  else
    python3 -c "import secrets;print(secrets.token_urlsafe(32))" > "$TOKFILE"
    chmod 600 "$TOKFILE"
    echo "· token: generado en $TOKFILE (0600)"
  fi

  echo "· buscando ledgers (*LEDGER*.md, *ledger*.md) en \$PWD, tu repo git y \$HOME (acotado)…"

  # Las rutas candidatas van por FICHERO, no por stdin: `python3 - <<HEREDOC` ya
  # usa stdin para el propio programa (el `-` le dice a python que lo lea de
  # ahí), así que un `algo | python3 - <<EOF` pierde silenciosamente todo lo que
  # venga por la tubería — el heredoc gana y `sys.stdin` dentro del script llega
  # vacío. Cazado en vivo probando de verdad: `init` caía SIEMPRE a "no
  # encontré ningún ledger" y creaba el demo aunque hubiera ledgers reales.
  candidatos_tmp="$(mktemp)"
  _descubrir_filtrado > "$candidatos_tmp"

  # CONFIRMACIÓN. El descubridor propone; quien decide es la persona.
  #
  # Cazado en la primera ejecución real: descubrió 27 ficheros e iba a montar dos que
  # su dueño tiene prohibido tocar —el de un cliente y el de otro equipo—. Ningún
  # patrón puede distinguir "es un ledger" de "es un ledger MÍO": los dos eran
  # legítimos, solo que ajenos.
  #
  # Y no es cosmético: montar un ledger, aunque sea en solo lectura, expone su
  # contenido a cualquiera que alcance el puerto. Un descubridor que acierta el 60%
  # y monta el resto en silencio es peor que uno que pregunta.
  #
  # `--si` (o `LLMINBOX_SI=1`) lo salta para scripts y CI.
  local n_desc n_tras
  n_desc=$(_descubrir_ledgers | wc -l | tr -d ' ')
  n_tras=$(wc -l < "$candidatos_tmp" | tr -d ' ')
  if [ "$n_desc" -ne "$n_tras" ]; then
    echo "· descartados $((n_desc - n_tras)) candidato(s) por LLMINBOX_EXCLUIR (respaldos, carpetas de sincronización, protocolos…)"
    _descubrir_ledgers | grep -E "$LLMINBOX_EXCLUIR" | sed 's/^/    ✗ /' | head -6
  fi

  if [ -z "${LLMINBOX_SI:-}" ] && [ "${1:-}" != "--si" ] && [ -t 0 ]; then
    echo
    echo "Voy a indexar estos $(wc -l < "$candidatos_tmp" | tr -d ' ') ledger(s):"
    cut -f1,3 "$candidatos_tmp" 2>/dev/null | sed 's/^/    /' || sed 's/^/    /' "$candidatos_tmp"
    echo
    echo "⚠️  Solo los tuyos. Un ledger de un cliente o de otro equipo NO debe ir aquí:"
    echo "    montarlo expone su contenido a quien alcance el puerto."
    printf "¿Sigo con todos? [s/N/e=editar] "
    read -r resp
    case "$resp" in
      s|S|y|Y) ;;
      e|E) "${EDITOR:-vi}" "$candidatos_tmp" ;;
      *) echo "Cancelado. Edita LLMINBOX_EXCLUIR o corre con --si cuando la lista esté bien."; exit 0 ;;
    esac
  fi

  # Todo lo demás —manifiesto, override, mapa de montajes, roster— es más
  # confiable en Python que a base de sed/awk sobre YAML/JSON a mano.
  # DIR/HOME/ROSTER/MOUNTS/candidatos por entorno, para no pelear con el
  # escapado de comillas al interpolar bash dentro del heredoc.
  LLMINBOX_DIR="$DIR" LLMINBOX_HOME="$HOME" LLMINBOX_ROSTER_PATH="$ROSTER" \
    LLMINBOX_MOUNTS_PATH="$MOUNTS" LLMINBOX_CANDIDATOS_PATH="$candidatos_tmp" \
    LLMINBOX_DEMO="${LLMINBOX_DEMO:-}" \
    python3 - <<'PYEOF'
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timedelta, timezone

DIR = os.environ["LLMINBOX_DIR"]
HOME = os.environ["LLMINBOX_HOME"]
ROSTER_PATH = os.environ["LLMINBOX_ROSTER_PATH"]
MOUNTS_PATH = os.environ["LLMINBOX_MOUNTS_PATH"]
CANDIDATOS_PATH = os.environ["LLMINBOX_CANDIDATOS_PATH"]

with open(CANDIDATOS_PATH, encoding="utf-8") as fh:
    candidatos = [ln.strip() for ln in fh if ln.strip()]
# realpath + dedup: $PWD, la raíz del repo git y $HOME se solapan a menudo.
vistos, rutas = set(), []
for p in candidatos:
    rp = os.path.realpath(p)
    if rp not in vistos and os.path.isfile(rp):
        vistos.add(rp)
        rutas.append(rp)


def es_git(carpeta):
    try:
        r = subprocess.run(["git", "-C", carpeta, "rev-parse", "--is-inside-work-tree"],
                            capture_output=True, text=True, timeout=3)
        return r.returncode == 0 and r.stdout.strip() == "true"
    except Exception:
        return False


def slug_de(ruta, usados):
    padre = os.path.basename(os.path.dirname(ruta))
    base = os.path.splitext(os.path.basename(ruta))[0]
    home_base = os.path.basename(os.path.normpath(HOME))
    # Un ledger suelto en la raíz de $HOME no tiene un nombre de carpeta útil
    # (sería literalmente tu $HOME) — en ese caso se nombra por el fichero.
    cand = base if (not padre or padre == home_base) else padre
    cand = cand.lower().replace(" ", "-").replace("_", "-")
    cand = "".join(c for c in cand if c.isalnum() or c == "-").strip("-")
    for sufijo in ("-ledger", "-ledgers"):
        if cand.endswith(sufijo) and len(cand) > len(sufijo):
            cand = cand[: -len(sufijo)]
    cand = cand or "ledger"
    base_cand, n = cand, 2
    while cand in usados:
        cand = f"{base_cand}-{n}"
        n += 1
    usados.add(cand)
    return cand


usados_nombres = set()
manifiesto = []
for ruta in rutas:
    carpeta = os.path.dirname(ruta)
    nombre = slug_de(ruta, usados_nombres)
    git = es_git(carpeta)
    if git:
        manifiesto.append({
            "name": nombre, "host_path": ruta, "es_git": True,
            "host_mount": carpeta, "container_mount": f"/ledgers/{nombre}",
            "container_file": f"/ledgers/{nombre}/{os.path.basename(ruta)}",
        })
    else:
        manifiesto.append({
            "name": nombre, "host_path": ruta, "es_git": False,
            "host_mount": ruta, "container_mount": f"/ledgers/{nombre}.md",
            "container_file": f"/ledgers/{nombre}.md",
        })

demo = False
# `--demo` fuerza el ejemplo aunque HAYA ledgers reales. Sin esto, quien ya tiene
# los suyos no ve NUNCA cómo se supone que funciona — y el README lo promete.
if not manifiesto or os.environ.get("LLMINBOX_DEMO"):
    print("· creo un ledger de EJEMPLO"
          + (" (--demo: además de los tuyos)" if manifiesto else " — no encontré ninguno real")
          + ". El día uno no puede ser una pantalla vacía.")
    demo_dir = os.path.join(HOME, ".llminbox-demo")
    os.makedirs(demo_dir, exist_ok=True)
    demo_path = os.path.join(demo_dir, "LEDGER.md")

    AGENTES_DEMO = ["alice-backend", "alice-frontend", "bob-reviewer", "bob-research"]

    # Un hilo de coordinación PLAUSIBLE, en inglés (el producto es público). Antes
    # decía "entrada de ejemplo #48" repetido: enseñaba la mecánica y nada del valor.
    # Esto es lo primero que ve quien instala esto, y también lo que sale en la
    # captura del README — tiene que parecerse a un ledger de verdad.
    GUION = [
        ("alice-backend", "alice-frontend", "PRODUCED",
         "Auth endpoints are live on staging",
         "POST /v1/sessions and DELETE /v1/sessions are deployed. Contract matches the\n"
         "spec except one thing: expired tokens return 401 with an empty body, not the\n"
         "error envelope. I left it that way on purpose — the envelope leaked whether\n"
         "the account exists. Flagging it because your error handling assumes a body."),
        ("alice-frontend", "alice-backend", "ACK",
         "Adjusted — but the empty 401 breaks the retry banner",
         "Handled. One consequence you may not want: with no body I cannot tell an\n"
         "expired session from a revoked one, so both show the generic 'signed out'\n"
         "message. If that distinction matters to the user, we need a header."),
        ("bob-reviewer", "alice-backend", "REQUEST",
         "Need the rate limit on /v1/sessions before I sign off",
         "The endpoint is unauthenticated by definition, so it is the cheapest place to\n"
         "brute-force. I do not see a limiter in the diff. Is it upstream in the proxy?\n"
         "If so, point me at the config and I will verify it rather than assume it."),
        ("alice-backend", "bob-reviewer", "RESP",
         "It is in the proxy — and you were right to ask, it was wrong",
         "Config is at infra/proxy/limits.conf. 100 req/min per IP, which is useless\n"
         "against a distributed attempt. Tightened to 10/min per IP AND 5/min per\n"
         "account. Measured on the staging traffic: zero legitimate requests hit either."),
        ("bob-research", "equipo", "FYI",
         "Three auth libraries compared — none of them fit",
         "Looked at the usual three. All of them assume a session store we do not have,\n"
         "and adopting one means either running Redis or rewriting the token model.\n"
         "Recommendation: keep the current 40 lines. Written up with the numbers."),
        ("bob-reviewer", "equipo", "DONE",
         "Auth review closed — two findings, both fixed",
         "The rate limit above, and a timing difference between 'unknown account' and\n"
         "'wrong password' that made account enumeration possible. Both verified fixed\n"
         "against staging, not just in the diff."),
        ("alice-frontend", "bob-reviewer", "REQUEST",
         "Can you look at the session-expiry banner before it ships?",
         "It is the one piece of auth UI a user sees when things go wrong, and I have\n"
         "no way to test the revoked-session path locally. Branch is up."),
        ("alice-backend", "equipo", "HEARTBEAT",
         "still on the migration, nothing blocking",
         "Backfill is at 60%. No action needed from anyone."),
    ]

    # Determinista por aritmética (índices, no random): mismo demo en cada máquina,
    # sin depender de una semilla que nadie vuelve a mirar.
    ahora = datetime.now(timezone.utc)
    lineas = []
    n_entradas = 48
    for i in range(n_entradas):
        actor, dest, tipo, titular, cuerpo = GUION[i % len(GUION)]
        vuelta = i // len(GUION)
        ts = ahora - timedelta(hours=(n_entradas - i) * 3, minutes=(i * 7) % 60)
        ts_s = ts.strftime("%Y-%m-%dT%H:%M:%SZ")
        # El guion se repite en vueltas; se numera para que las entradas no salgan
        # byte a byte idénticas — con identidad por CONTENIDO, dos iguales son UNA.
        suf = "" if vuelta == 0 else f" (round {vuelta + 1})"
        lineas.append(
            f"### [{actor} → {dest} · {tipo}] {ts_s} — {titular}{suf}\n"
            f"{cuerpo}\n\n"
        )
    with open(demo_path, "w", encoding="utf-8") as fh:
