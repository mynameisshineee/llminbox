          # el cursor solo, y un GET que muta se lo puede disparar cualquiera —
          # incluido un <img src> en una página abierta en el Mac. Y si esta sesión
          # se cae entre leer y marcar, el correo sigue ahí: pierde un ciclo, no un
          # mensaje.
          out="$(_get_inbox_o_422 "$1" "${2:-30}")"; rc=$?
          [ $rc -eq 0 ] || exit $rc
          printf '%s\n' "$out"
          # El pie del servicio es `marcar leído — pega esto tal cual:` + una línea
          # `{"hasta":{...}}`. El sed antiguo buscaba `marcar leído: … → ` — un
          # formato que el servicio NO emite (¿nunca emitió?): la extracción moría
          # en silencio y `inbox` se quedaba en peek con otro nombre. Cazado por el
          # falsador vivo de ③ (2026-08-10): el cursor del carril no avanzaba ni
          # con el carril bien puesto. Ahora se coge el JSON del pie tal cual — el
          # mismo payload que el humano pegaría — y el ámbito lo decide el
          # servidor por la cabecera X-Llminbox-Carril, no este script.
          json="$(sed -n 's/^ *\({"hasta":.*}\)$/\1/p' <<<"$out" | tail -1)"
          if [ -n "$json" ]; then
