try: print(json.load(open(sys.argv[1])).get("detail",""), file=sys.stderr)
except Exception: print(open(sys.argv[1]).read(), file=sys.stderr)' "$cuerpo_post"
                   rm -f "$cuerpo_post"; exit 4 ;;
